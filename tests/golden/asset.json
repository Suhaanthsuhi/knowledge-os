          "image": null,
          "level": null,
          "order": 2,
          "page_number": 1,
          "parent_id": "p1e000",
          "table": null,
          "text": "The Payment API depends on Redis for caching and PostgreSQL for\npersistent storage.",
          "type": "paragraph"
        },
        {
          "attrs": {
            "synthetic_bbox": true
          },
          "bbox": {
