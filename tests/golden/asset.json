          "level": null,
          "order": 3,
          "page_number": 1,
          "parent_id": "p1e000",
          "table": null,
          "text": "The Payments Team owns the Payment API.",
          "type": "paragraph"
        },
        {
          "attrs": {
            "synthetic_bbox": true
          },
          "bbox": {
